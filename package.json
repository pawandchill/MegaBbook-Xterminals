{
  "name": "megabbook-xterminal",
  "version": "1.0.0",
  "description": "MegaBbook Xterminal — Windows desktop terminal and SSH client",
  "private": true,
  "main": "dist/src/electron/main.js",
  "build": {
    "appId": "com.megabbook.xterminal",
    "productName": "MegaBbook Xterminal",
    "asar": true,
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "dist/**/*",
      "database/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"wait-on tcp:5173 && electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsx watch src/electron/main.ts",
    "build": "npm run build:renderer && npm run build:main && electron-builder --win",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.8.0",
    "@xterm/addon-search": "^0.11.0",
    "classnames": "^2.1.0",
    "electron": "^32.0.0",
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7",
    "ssh2": "^1.16.0",
    "xterm": "^5.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.0",
    "electron-builder": "^25.1.1",
    "eslint": "^9.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "wait-on": "^7.1.0"
  }
}
